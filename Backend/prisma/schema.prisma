// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EntranceExamType {
  READING
  LISTENING
  SPEAKING
  WRITING
  READING_LISTENING
  SPEAKING_WRITING
  ALL
}

enum RoleName {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum CourseType {
  COURSE
  TEST_PREPARATION
}

enum CourseSkill {
  READING_LISTENING
  SPEAKING_WRITING
  ALL
}

enum CourseStatus {
  PLANNING
  ACTIVE
  INACTIVE
  COMPLETED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}


model User {
  id        Int       @id @default(autoincrement())
  fullname  String
  email     String    @unique
  password  String
  phone     String    @unique
  role      RoleName  @default(STUDENT)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teacherInfo TeacherInfo?
  studentInfo StudentInfo?
  parentInfo  ParentInfo?
}

model TeacherInfo {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  isTeaching Boolean   @default(false)
  degree     String
  avatar     String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  freeDays  TeacherFreeDay[]
  schedules Schedule[]

  @@index([userId])
}

model TeacherFreeDay {
  id        Int       @id @default(autoincrement())
  teacherId Int
  day       DayOfWeek
  createdAt DateTime  @default(now())

  teacher TeacherInfo @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, day])
  @@index([teacherId])
}

model StudentInfo {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  dob       DateTime?
  cccd      String?
  scoreRl   Int       @default(0)
  scoreSw   Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents               ParentStudent[]
  registerCourses       StudentRegisterCourse[]
  scheduleRegistrations ScheduleRegistration[]
  attendanceRecords     AttendanceRecord[]
  scoreCourses          ScoreCourse[]

  @@index([userId])
}

model ParentInfo {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students ParentStudent[]

  @@index([userId])
}

model ParentStudent {
  id        Int      @id @default(autoincrement())
  parentId  Int
  studentId Int
  createdAt DateTime @default(now())

  parent  ParentInfo  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentInfo @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model StudentRegisterCourse {
  id        Int      @id @default(autoincrement())
  studentId Int
  courseId  Int
  createdAt DateTime @default(now())

  student StudentInfo @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model Admission {
  id             Int              @id @default(autoincrement())
  entranceExamId Int?
  email          String
  fullname       String
  entranceScore  Int              @default(0)
  type           EntranceExamType
  isDone         Boolean          @default(false)
  totalListening Int              @default(0)
  totalReading   Int              @default(0)
  totalSpeaking  Int              @default(0)
  totalWriting   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  entranceExam        EntranceExam?         @relation(fields: [entranceExamId], references: [id], onDelete: SetNull)
  admissionsListening AdmissionsListening[]
  admissionsReading   AdmissionsReading[]
  admissionsSpeaking  AdmissionsSpeaking[]
  admissionsWriting   AdmissionsWriting[]

  @@index([entranceExamId])
}

model AdmissionsListening {
  id          Int      @id @default(autoincrement())
  admissionId Int
  questionId  Int
  answerId    Int?
  createdAt   DateTime @default(now())

  admission Admission                     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  question  EntranceExamListeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer    EntranceExamListeningAnswer?  @relation(fields: [answerId], references: [id], onDelete: SetNull)

  @@index([admissionId])
  @@index([questionId])
  @@index([answerId])
}

model AdmissionsReading {
  id          Int      @id @default(autoincrement())
  admissionId Int
  questionId  Int
  answerId    Int?
  createdAt   DateTime @default(now())

  admission Admission                   @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  question  EntranceExamReadingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer    EntranceExamReadingAnswer?  @relation(fields: [answerId], references: [id], onDelete: SetNull)

  @@index([admissionId])
  @@index([questionId])
  @@index([answerId])
}

model AdmissionsSpeaking {
  id          Int      @id @default(autoincrement())
  admissionId Int
  questionId  Int
  audioRecord String
  createdAt   DateTime @default(now())

  admission Admission                    @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  question  EntranceExamSpeakingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([questionId])
}

model AdmissionsWriting {
  id          Int      @id @default(autoincrement())
  admissionId Int
  questionId  Int
  answer      String?
  createdAt   DateTime @default(now())

  admission Admission                   @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  question  EntranceExamWritingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([questionId])
}

model EntranceExam {
  id              Int                 @id @default(autoincrement())
  name            String
  type            CourseSkill

  // Relation fields - optional based on type
  listening       EntranceExamListening? @relation(fields: [listeningExamId], references: [id])
  listeningExamId Int?
  
  reading         EntranceExamReading?   @relation(fields: [readingExamId], references: [id])
  readingExamId   Int?
  
  speaking        EntranceExamSpeaking?  @relation(fields: [speakingExamId], references: [id])
  speakingExamId  Int?
  
  writing         EntranceExamWriting?   @relation(fields: [writingExamId], references: [id])
  writingExamId   Int?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  admissions      Admission[]
}

model EntranceExamListening {
  id                Int                          @id @default(autoincrement())
  name              String                       @unique
  listeningQuestions EntranceExamListeningQuestion[]
  
  entranceExams     EntranceExam[]
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
}

model EntranceExamReading {
  id               Int                        @id @default(autoincrement())
  name             String                     @unique
  readingQuestions  EntranceExamReadingQuestion[]
  
  entranceExams     EntranceExam[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
}

model EntranceExamSpeaking {
  id                Int                         @id @default(autoincrement())
  name              String                      @unique
  speakingQuestions  EntranceExamSpeakingQuestion[]
  
  entranceExams     EntranceExam[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
}

model EntranceExamWriting {
  id               Int                        @id @default(autoincrement())
  name             String                     @unique

  writingQuestions  EntranceExamWritingQuestion[]
  entranceExams     EntranceExam[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
}
model EntranceExamListeningQuestion {
  id              Int      @id @default(autoincrement())
  listeningExamId Int
  index           Int
  part            Int
  question        String
  image           String?
  createdAt       DateTime @default(now())

  entranceExamListening EntranceExamListening        @relation(fields: [listeningExamId], references: [id], onDelete: Cascade)
  answers                EntranceExamListeningAnswer[]
  admissionsListening    AdmissionsListening[]

  @@index([listeningExamId])
}

model EntranceExamListeningAnswer {
  id                      Int      @id @default(autoincrement())
  questionId              Int
  part                    Int
  answer                  String?
  isTrue                  Boolean
  createdAt               DateTime @default(now())

  question              EntranceExamListeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  admissionsListening    AdmissionsListening[]

  @@index([questionId])
}

model EntranceExamReadingQuestion {
  id            Int      @id @default(autoincrement())
  readingExamId Int
  index         Int
  part          Int
  question      String
  image         String?
  createdAt     DateTime @default(now())

  entranceExamReading EntranceExamReading       @relation(fields: [readingExamId], references: [id], onDelete: Cascade)
  answers             EntranceExamReadingAnswer[]
  admissionsReading   AdmissionsReading[]

  @@index([readingExamId])
}

model EntranceExamReadingAnswer {
  id         Int      @id @default(autoincrement())
  questionId Int
  part       Int
  answer     String?
  isTrue     Boolean
  createdAt  DateTime @default(now())

  question          EntranceExamReadingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  admissionsReading AdmissionsReading[]

  @@index([questionId])
}

model EntranceExamSpeakingQuestion {
  id               Int      @id @default(autoincrement())
  speakingExamId   Int
  index            Int
  question         String
  image            String?
  descriptionForAi String?
  timeToReadInfo   Int
  preparationTime  Int
  presentationTime Int
  createdAt        DateTime @default(now())

  entranceExamSpeaking EntranceExamSpeaking       @relation(fields: [speakingExamId], references: [id], onDelete: Cascade)
  admissionsSpeaking  AdmissionsSpeaking[]

  @@index([speakingExamId])
}

model EntranceExamWritingQuestion {
  id                    Int      @id @default(autoincrement())
  writingExamId         Int
  index                 Int
  question              String
  image                 String?
  descriptionImageForAi String?
  createdAt             DateTime @default(now())

  entranceExamWriting EntranceExamWriting      @relation(fields: [writingExamId], references: [id], onDelete: Cascade)
  admissionsWriting  AdmissionsWriting[]

  @@index([writingExamId])
}

model Course {
  id        Int      @id @default(autoincrement())
  type      CourseType
  name      String
  courseSkill CourseSkill
  status    CourseStatus
  price     Decimal  @db.Decimal(10, 2)
  sale      Int      @default(0)
  thumbnail String
  minBand   Int?     @default(0)
  maxBand   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests                CourseTest[]
  studentRegistrations StudentRegisterCourse[]
  schedules            Schedule[]
}

model CourseTest {
  id        Int      @id @default(autoincrement())
  courseId  Int
  name      String
  index     Int
  fileTest  String
  audioTest String?
  createdAt DateTime @default(now())

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scoreCourses ScoreCourse[]

  @@index([courseId])
}

model Classroom {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  maxSize   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules Schedule[]
}

model Schedule {
  id            Int      @id @default(autoincrement())
  teacherId     Int
  classroomId   Int
  coursesId     Int
  totalSlot     Int
  totalRegister Int
  startTime     DateTime
  endTime       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher       TeacherInfo            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroom     Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  course        Course                 @relation(fields: [coursesId], references: [id], onDelete: Cascade)
  sessions      ScheduleSession[]
  registrations ScheduleRegistration[]

  @@index([teacherId])
  @@index([classroomId])
  @@index([coursesId])
}

model ScheduleSession {
  id         Int       @id @default(autoincrement())
  scheduleId Int
  day        DayOfWeek
  startTime  String
  endTime    String
  createdAt  DateTime  @default(now())

  schedule    Schedule             @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  attendances ScheduleAttendance[]

  @@index([scheduleId])
}

model ScheduleRegistration {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  studentId  Int
  createdAt  DateTime @default(now())

  schedule Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  StudentInfo @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId])
  @@index([scheduleId])
  @@index([studentId])
}

model ScheduleAttendance {
  id            Int      @id @default(autoincrement())
  scheduleDayId Int
  qrCode        String
  totalAbsent   Int
  createdAt     DateTime @default(now())

  scheduleSession ScheduleSession    @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)
  records         AttendanceRecord[]

  @@index([scheduleDayId])
}

model AttendanceRecord {
  id                   Int      @id @default(autoincrement())
  scheduleAttendanceId Int
  studentId            Int
  time                 String
  createdAt            DateTime @default(now())

  scheduleAttendance ScheduleAttendance @relation(fields: [scheduleAttendanceId], references: [id], onDelete: Cascade)
  student            StudentInfo        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleAttendanceId, studentId])
  @@index([scheduleAttendanceId])
  @@index([studentId])
}

model ScoreCourse {
  id           Int      @id @default(autoincrement())
  courseTestId Int
  studentId    Int
  score        Int
  createdAt    DateTime @default(now())

  courseTest CourseTest  @relation(fields: [courseTestId], references: [id], onDelete: Cascade)
  student    StudentInfo @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseTestId, studentId])
  @@index([courseTestId])
  @@index([studentId])
}
