// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum EntranceExamType {
  READING_LISTENING
  SPEAKING_WRITING
}

enum RoleName {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum CourseType {
  COURSE
  TEST_PREPARATION
}

enum CourseSkill {
  READING_LISTENING
  SPEAKING_WRITING
  ALL
}

enum CourseStatus {
  PLANNING
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}


model User {
  id        Int       @id @default(autoincrement())
  fullname  String
  email     String    @unique
  password  String
  phone     String    @unique
  role      RoleName  @default(STUDENT)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teacherInfo TeacherInfo?
  studentInfo StudentInfo?
  parentInfo  ParentInfo?

  @@map("user")
}

model TeacherInfo {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  isTeaching Boolean   @default(false)
  degree     String
  avatar     String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  freeDays  TeacherFreeDay[]
  schedules Schedule[]

  @@index([userId])
  @@map("teacher_info")
}

model TeacherFreeDay {
  id        Int       @id @default(autoincrement())
  teacherId Int
  day       DayOfWeek
  createdAt DateTime  @default(now())

  teacher TeacherInfo @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, day])
  @@index([teacherId])
  @@map("teacher_free_day")
}

model StudentInfo {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  dob       DateTime?
  cccd      String?
  scoreRl   Int       @default(0)
  scoreSw   Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents               ParentStudent[]
  registerCourses       StudentRegisterCourse[]
  scheduleRegistrations ScheduleRegistration[]
  attendanceRecords     AttendanceRecord[]
  scoreCourses          ScoreCourse[]

  @@index([userId])
  @@map("student_info")
}

model ParentInfo {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students ParentStudent[]

  @@index([userId])
  @@map("parent_info")
}

model ParentStudent {
  id        Int      @id @default(autoincrement())
  parentId  Int
  studentId Int
  createdAt DateTime @default(now())

  parent  ParentInfo  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentInfo @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_student")
}

model StudentRegisterCourse {
  id        Int      @id @default(autoincrement())
  studentId Int
  courseId  Int
  createdAt DateTime @default(now())

  student StudentInfo @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("student_register_course")
}

model Admission {
  id             Int              @id @default(autoincrement())
  entranceExamId Int?
  email          String
  fullname       String
  entranceScore  Int              @default(0)
  type           EntranceExamType
  isDone         Boolean          @default(false)
  totalListening Int              @default(0)
  totalReading   Int              @default(0)
  totalSpeaking  Int              @default(0)
  totalWriting   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  entranceExam        EntranceExam?         @relation(fields: [entranceExamId], references: [id], onDelete: SetNull)
  admissionsListening AdmissionsListening[]
  admissionsReading   AdmissionsReading[]
  admissionsSpeaking  AdmissionsSpeaking[]
  admissionsWriting   AdmissionsWriting[]

  @@index([entranceExamId])
  @@map("admission")
}

model AdmissionsListening {
  id          Int      @id @default(autoincrement())
  admissionId Int
  questionId  Int
  answerId    Int?
  createdAt   DateTime @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([questionId])
  @@index([answerId])
  @@map("admissions_listening")
}

model AdmissionsReading {
  id          Int      @id @default(autoincrement())
  admissionId Int
  questionId  Int
  answerId    Int?
  createdAt   DateTime @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([questionId])
  @@index([answerId])
  @@map("admissions_reading")
}

model AdmissionsSpeaking {
  id          Int      @id @default(autoincrement())
  admissionId Int
  questionId  Int
  audioRecord String
  createdAt   DateTime @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([questionId])
  @@map("admissions_speaking")
}

model AdmissionsWriting {
  id          Int      @id @default(autoincrement())
  admissionId Int
  questionId  Int
  answer      String?
  createdAt   DateTime @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([questionId])
  @@map("admissions_writing")
}

model EntranceExam {
  id              Int                 @id @default(autoincrement())
  name            String
  type            EntranceExamType // READING_LISTENING (120m) or SPEAKING_WRITING (80m)
  time            Int                 // in minutes

  // Relation fields - optional based on type
  listening       EntranceExamListening? @relation(fields: [listeningExamId], references: [id])
  listeningExamId Int?
  
  reading         EntranceExamReading?   @relation(fields: [readingExamId], references: [id])
  readingExamId   Int?
  
  speaking        EntranceExamSpeaking?  @relation(fields: [speakingExamId], references: [id])
  speakingExamId  Int?
  
  writing         EntranceExamWriting?   @relation(fields: [writingExamId], references: [id])
  writingExamId   Int?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  admissions      Admission[]

  @@map("entrance_exam")
}

/*
Start Listening
*/
model EntranceExamListening {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  direction     String   @db.Text
  isDone        Boolean  @default(false)
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entranceExams  EntranceExam[]
  partOnes       PartOne[]
  partTwos       PartTwo[]
  partThrees     PartThree[]
  partFours      PartFour[]
  trueAnswers    EntranceExamListeningTrueAnswer[]

  @@map("entrance_exam_listening")
}

model PartOne {
  id              Int      @id @default(autoincrement())
  listeningExamId Int
  direction       String   @db.Text
  totalQuestion   Int      @default(6)
  quantityQuestionDone Int      @default(0)
  isDone          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listeningExam EntranceExamListening @relation(fields: [listeningExamId], references: [id], onDelete: Cascade)
  questions     PartOneQuestion[]

  @@index([listeningExamId])
  @@map("part_one")
}

model PartOneQuestion {
  id         Int      @id @default(autoincrement())
  partOneId  Int
  index      Int
  audio      String
  question   String
  image      String
  createdAt  DateTime @default(now())

  partOne    PartOne   @relation(fields: [partOneId], references: [id], onDelete: Cascade)

  @@index([partOneId])
  @@map("part_one_question")
}

model PartTwo {
  id              Int      @id @default(autoincrement())
  listeningExamId Int
  direction       String   @db.Text
  totalQuestion   Int      @default(25)
  quantityQuestionDone Int      @default(0)
  isDone          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listeningExam EntranceExamListening @relation(fields: [listeningExamId], references: [id], onDelete: Cascade)
  questions     PartTwoQuestion[]

  @@index([listeningExamId])
  @@map("part_two")
}

model PartTwoQuestion {
  id         Int      @id @default(autoincrement())
  partTwoId  Int
  index      Int
  audio      String
  question   String @default("Make your answer on your answer sheet.")
  createdAt  DateTime @default(now())

  partTwo    PartTwo   @relation(fields: [partTwoId], references: [id], onDelete: Cascade)

  @@index([partTwoId])
  @@map("part_two_question")
}

model PartThree {
  id              Int      @id @default(autoincrement())
  listeningExamId Int
  direction       String   @db.Text
  totalQuestion   Int      @default(39)
  quantityQuestionDone Int      @default(0)
  isDone          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listeningExam EntranceExamListening @relation(fields: [listeningExamId], references: [id], onDelete: Cascade)
  groups        PartThreeGroup[]

  @@index([listeningExamId])
  @@map("part_three")
}

model PartThreeGroup {
  id         Int      @id @default(autoincrement())
  index      Int
  partThreeId Int
  audio      String
  image     String?
  fromQuestionIndex Int
  toQuestionIndex   Int
  createdAt  DateTime @default(now())

  partThree PartThree @relation(fields: [partThreeId], references: [id], onDelete: Cascade)
  questions PartThreeQuestion[]

  @@index([partThreeId])
  @@map("part_three_group")
}

model PartThreeQuestion {
  id         Int      @id @default(autoincrement())
  partThreeGroupId Int
  index      Int
  question   String
  answerA    String
  answerB    String
  answerC    String
  answerD    String
  createdAt  DateTime @default(now())

  partThreeGroup PartThreeGroup @relation(fields: [partThreeGroupId], references: [id], onDelete: Cascade)

  @@index([partThreeGroupId])
  @@map("part_three_question")
}

model PartFour {
  id              Int      @id @default(autoincrement())
  listeningExamId Int
  direction       String   @db.Text
  totalQuestion   Int      @default(30)
  quantityQuestionDone Int      @default(0)
  isDone          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listeningExam EntranceExamListening @relation(fields: [listeningExamId], references: [id], onDelete: Cascade)
  groups        PartFourGroup[]

  @@index([listeningExamId])
  @@map("part_four")
}

model PartFourGroup {
  id         Int      @id @default(autoincrement())
  index      Int
  partFourId Int
  audio      String
  image     String?
  fromQuestionIndex Int
  toQuestionIndex   Int
  createdAt  DateTime @default(now())

  partFour PartFour @relation(fields: [partFourId], references: [id], onDelete: Cascade)
  questions PartFourQuestion[]

  @@index([partFourId])
  @@map("part_four_group")
}

model PartFourQuestion {
  id         Int      @id @default(autoincrement())
  partFourGroupId Int
  index      Int
  question   String
  answerA    String
  answerB    String
  answerC    String
  answerD    String
  createdAt  DateTime @default(now())

  partFourGroup PartFourGroup @relation(fields: [partFourGroupId], references: [id], onDelete: Cascade)

  @@index([partFourGroupId])
  @@map("part_four_question")
}

/*
End Listening
*/

/*
Start Reading
*/
model EntranceExamReading {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  direction   String   @db.Text
  isDone      Boolean  @default(false)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entranceExams EntranceExam[]
  partFives     PartFive[]
  partSixes     PartSix[]
  partSevens    PartSeven[]
  trueAnswers   EntranceExamReadingTrueAnswer[]

  @@map("entrance_exam_reading")
}

model PartFive {
  id            Int      @id @default(autoincrement())
  readingExamId Int
  direction     String   @db.Text
  totalQuestion Int      @default(30)
  quantityQuestionDone Int      @default(0)
  isDone        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  readingExam EntranceExamReading @relation(fields: [readingExamId], references: [id], onDelete: Cascade)
  questions   PartFiveQuestion[]

  @@index([readingExamId])
  @@map("part_five")
}

model PartFiveQuestion {
  id         Int      @id @default(autoincrement())
  partFiveId Int
  index      Int
  question   String
  answerA    String
  answerB    String
  answerC    String
  answerD    String
  createdAt  DateTime @default(now())

  partFive PartFive @relation(fields: [partFiveId], references: [id], onDelete: Cascade)

  @@index([partFiveId])
  @@map("part_five_question")
}

model PartSix {
  id            Int      @id @default(autoincrement())
  readingExamId Int
  direction     String   @db.Text
  totalQuestion Int      @default(16)
  quantityQuestionDone Int      @default(0)
  isDone        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  readingExam EntranceExamReading @relation(fields: [readingExamId], references: [id], onDelete: Cascade)
  groups      PartSixGroup[]

  @@index([readingExamId])
  @@map("part_six")
}

model PartSixGroup {
  id         Int      @id @default(autoincrement())
  index      Int
  partSixId  Int
  question   String?
  image     String?
  fromQuestionIndex Int
  toQuestionIndex   Int
  createdAt  DateTime @default(now())

  partSix PartSix @relation(fields: [partSixId], references: [id], onDelete: Cascade)
  questions PartSixQuestion[]

  @@index([partSixId])
  @@map("part_six_group")
}

model PartSixQuestion {
  id         Int      @id @default(autoincrement())
  partSixGroupId Int
  index      Int
  question   String
  answerA    String
  answerB    String
  answerC    String
  answerD    String
  createdAt  DateTime @default(now())

  partSixGroup PartSixGroup @relation(fields: [partSixGroupId], references: [id], onDelete: Cascade)

  @@index([partSixGroupId])
  @@map("part_six_question")
}

model PartSeven {
  id            Int      @id @default(autoincrement())
  readingExamId Int
  direction     String   @db.Text
  totalQuestion Int      @default(54)
  quantityQuestionDone Int      @default(0)
  isDone        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  readingExam EntranceExamReading @relation(fields: [readingExamId], references: [id], onDelete: Cascade)
  groups      PartSevenGroup[]

  @@index([readingExamId])
  @@map("part_seven")
}

model PartSevenGroup {
  id         Int      @id @default(autoincrement())
  index      Int
  partSevenId Int
  question   String?
  image     String?
  fromQuestionIndex Int
  toQuestionIndex   Int
  createdAt  DateTime @default(now())

  partSeven PartSeven @relation(fields: [partSevenId], references: [id], onDelete: Cascade)
  questions PartSevenQuestion[]

  @@index([partSevenId])
  @@map("part_seven_group")
}

model PartSevenQuestion {
  id         Int      @id @default(autoincrement())
  partSevenGroupId Int
  index      Int
  question   String
  answerA    String
  answerB    String
  answerC    String
  answerD    String
  createdAt  DateTime @default(now())

  partSevenGroup PartSevenGroup @relation(fields: [partSevenGroupId], references: [id], onDelete: Cascade)

  @@index([partSevenGroupId])
  @@map("part_seven_question")
}


/*
End Reading
*/

/*
Reading and Listening answer sheet
*/
model EntranceExamListeningTrueAnswer {
  id          Int      @id @default(autoincrement())
  entranceExamListeningId Int
  index      Int
  answer      String
  createdAt   DateTime @default(now())
  entranceExamListening EntranceExamListening @relation(fields: [entranceExamListeningId], references: [id], onDelete: Cascade)

  @@index([entranceExamListeningId])
  @@map("entrance_exam_listening_true_answer")
}

model EntranceExamReadingTrueAnswer {
  id          Int      @id @default(autoincrement())
  entranceExamReadingId Int
  index      Int
  answer      String
  createdAt   DateTime @default(now())
  entranceExamReading EntranceExamReading @relation(fields: [entranceExamReadingId], references: [id], onDelete: Cascade)

  @@index([entranceExamReadingId])
  @@map("entrance_exam_reading_true_answer")
}

/*
Start Speaking
*/
model EntranceExamSpeaking {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  totalQuestion Int      @default(11)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entranceExams      EntranceExam[]
  speakingOneTwos    SpeakingOneTwo[]
  speakingThreeFours SpeakingThreeFour[]
  speakingFiveToSevens SpeakingFiveToSeven[]
  speakingEightToTens  SpeakingEightToTen[]
  speakingElevens    SpeakingEleven[]

  @@map("entrance_exam_speaking")
}

model SpeakingOneTwo {
  id         Int      @id @default(autoincrement())
  index      Int
  speakingExamId Int
  questionOne   String
  questionTwo   String
  createdAt  DateTime @default(now())

  speakingExam EntranceExamSpeaking @relation(fields: [speakingExamId], references: [id], onDelete: Cascade)

  @@index([speakingExamId])
  @@map("speaking_one_two")
}

model SpeakingThreeFour {
  id         Int      @id @default(autoincrement())
  index      Int
  speakingExamId Int
  imageThree     String
  imageFour     String
  createdAt  DateTime @default(now())

  speakingExam EntranceExamSpeaking @relation(fields: [speakingExamId], references: [id], onDelete: Cascade)

  @@index([speakingExamId])
  @@map("speaking_three_four")
}

model SpeakingFiveToSeven {
  id         Int      @id @default(autoincrement())
  index      Int
  speakingExamId Int
  passage     String
  questionFive   String
  questionSix    String
  questionSeven  String
  createdAt  DateTime @default(now())

  speakingExam EntranceExamSpeaking @relation(fields: [speakingExamId], references: [id], onDelete: Cascade)

  @@index([speakingExamId])
  @@map("speaking_five_to_seven")
}

model SpeakingEightToTen {
  id         Int      @id @default(autoincrement())
  index      Int
  speakingExamId Int
  passage     String
  questionEight   String
  questionNine    String
  questionTen  String
  image String?
  createdAt  DateTime @default(now())

  speakingExam EntranceExamSpeaking @relation(fields: [speakingExamId], references: [id], onDelete: Cascade)

  @@index([speakingExamId])
  @@map("speaking_eight_to_ten")
}

model SpeakingEleven {
  id         Int      @id @default(autoincrement())
  index      Int
  speakingExamId Int
  question   String
  createdAt  DateTime @default(now())

  speakingExam EntranceExamSpeaking @relation(fields: [speakingExamId], references: [id], onDelete: Cascade)

  @@index([speakingExamId])
  @@map("speaking_eleven")
}

/*
End Speaking
*/

/*
Start Writing
*/
model EntranceExamWriting {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entranceExams    EntranceExam[]
  writingOneToFives WritingOneToFive[]
  writingSixSevens  WritingSixSeven[]
  writingEights     WritingEight[]

  @@map("entrance_exam_writing")
}

model WritingOneToFive {
  id         Int      @id @default(autoincrement())
  index      Int
  writingExamId Int
  imageOne     String
  imageTwo     String
  imageThree     String
  imageFour     String
  imageFive     String
  createdAt  DateTime @default(now())

  writingExam EntranceExamWriting @relation(fields: [writingExamId], references: [id], onDelete: Cascade)

  @@index([writingExamId])
  @@map("writing_one_to_five")
}

model WritingSixSeven {
  id         Int      @id @default(autoincrement())
  index      Int
  writingExamId Int
  imageSix     String
  imageSeven     String
  createdAt  DateTime @default(now())

  writingExam EntranceExamWriting @relation(fields: [writingExamId], references: [id], onDelete: Cascade)

  @@index([writingExamId])
  @@map("writing_six_seven")
}

model WritingEight {
  id         Int      @id @default(autoincrement())
  index      Int
  writingExamId Int
  questionEight   String
  createdAt  DateTime @default(now())

  writingExam EntranceExamWriting @relation(fields: [writingExamId], references: [id], onDelete: Cascade)

  @@index([writingExamId])
  @@map("writing_eight")
}

/*
End Writing
*/

model Course {
  id        Int      @id @default(autoincrement())
  type      CourseType
  name      String
  courseSkill CourseSkill
  status    CourseStatus
  price     Decimal  @db.Decimal(10, 2)
  sale      Int      @default(0)
  thumbnail String
  minBand   Int?     @default(0)
  maxBand   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests                CourseTest[]
  studentRegistrations StudentRegisterCourse[]
  schedules            Schedule[]

  @@map("course")
}

model CourseTest {
  id        Int      @id @default(autoincrement())
  courseId  Int
  name      String
  index     Int
  fileTest  String
  audioTest String?
  createdAt DateTime @default(now())

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scoreCourses ScoreCourse[]

  @@index([courseId])
  @@map("course_test")
}

model Classroom {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  maxSize   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules Schedule[]

  @@map("classroom")
}

model Schedule {
  id            Int      @id @default(autoincrement())
  teacherId     Int
  classroomId   Int
  coursesId     Int
  totalSlot     Int
  totalRegister Int
  startTime     DateTime
  endTime       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher       TeacherInfo            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroom     Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  course        Course                 @relation(fields: [coursesId], references: [id], onDelete: Cascade)
  sessions      ScheduleSession[]
  registrations ScheduleRegistration[]

  @@index([teacherId])
  @@index([classroomId])
  @@index([coursesId])
  @@map("schedule")
}

model ScheduleSession {
  id         Int       @id @default(autoincrement())
  scheduleId Int
  day        DayOfWeek
  startTime  String
  endTime    String
  createdAt  DateTime  @default(now())

  schedule    Schedule             @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  attendances ScheduleAttendance[]

  @@index([scheduleId])
  @@map("schedule_session")
}

model ScheduleRegistration {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  studentId  Int
  createdAt  DateTime @default(now())

  schedule Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  StudentInfo @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId])
  @@index([scheduleId])
  @@index([studentId])
  @@map("schedule_registration")
}

model ScheduleAttendance {
  id            Int      @id @default(autoincrement())
  scheduleDayId Int
  qrCode        String
  totalAbsent   Int
  createdAt     DateTime @default(now())

  scheduleSession ScheduleSession    @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)
  records         AttendanceRecord[]

  @@index([scheduleDayId])
  @@map("schedule_attendance")
}

model AttendanceRecord {
  id                   Int      @id @default(autoincrement())
  scheduleAttendanceId Int
  studentId            Int
  time                 String
  createdAt            DateTime @default(now())

  scheduleAttendance ScheduleAttendance @relation(fields: [scheduleAttendanceId], references: [id], onDelete: Cascade)
  student            StudentInfo        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleAttendanceId, studentId])
  @@index([scheduleAttendanceId])
  @@index([studentId])
  @@map("attendance_record")
}

model ScoreCourse {
  id           Int      @id @default(autoincrement())
  courseTestId Int
  studentId    Int
  score        Int
  createdAt    DateTime @default(now())

  courseTest CourseTest  @relation(fields: [courseTestId], references: [id], onDelete: Cascade)
  student    StudentInfo @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseTestId, studentId])
  @@index([courseTestId])
  @@index([studentId])
  @@map("score_course")
}
